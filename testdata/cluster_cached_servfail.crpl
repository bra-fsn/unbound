; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-peer: 10.0.0.4
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a SERVFAIL that the owner answers from its cache is not charged to the owner.
; 4 peers (10.0.0.1 is this node); the names are owned by 10.0.0.3, that
; answers the cache probes (MISS) and then answers SERVFAIL to the resolve
; request, with the OWNER_CACHE_HIT flag: this is the error response that
; the iterator of the owner keeps for 5 seconds, not a sign of an ill owner.
; The local fallback resolves quickly, but the failure is not charged: after
; four such failures (charge needs three in a row) the owner is still asked
; to resolve (q6).  A fresh SERVFAIL (no flag) is charged, see cluster_charge.
RANGE_BEGIN 0 100000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
q1.example.com. IN A
SECTION ANSWER
q1.example.com. 3600 IN A 10.8.8.1
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
q3.example.com. IN A
SECTION ANSWER
q3.example.com. 3600 IN A 10.8.8.2
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
q4.example.com. IN A
SECTION ANSWER
q4.example.com. 3600 IN A 10.8.8.3
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
q5.example.com. IN A
SECTION ANSWER
q5.example.com. 3600 IN A 10.8.8.4
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
q6.example.com. IN A
SECTION ANSWER
q6.example.com. 3600 IN A 10.8.8.5
ENTRY_END
RANGE_END

STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
q1.example.com. IN A
ENTRY_END

STEP 20 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
q1.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 03
		c1 68 3f 06 a9 43 ed 49
	HEX_EDNSDATA_END
ENTRY_END

STEP 30 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA REFUSED
SECTION QUESTION
q1.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 09
		00 00 00 00 00 00 00 03
	HEX_EDNSDATA_END
ENTRY_END

