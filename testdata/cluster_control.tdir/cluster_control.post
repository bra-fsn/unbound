# #-- cluster_control.post --#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# source the test var file when it's there
[ -f .tpkg.var.test ] && source .tpkg.var.test
#
# do your teardown here
. ../common.sh
PRE="../.."
kill_pid $AUTH_PID
kill_pid $A_PID
kill_pid $B_PID
echo "--- unbound A"
cat unbound_A.log
echo "--- unbound B"
cat unbound_B.log
exit 0
