; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: the owner answers before the deadline, the deadline timer is removed and does not fire later.
; www.example.com is owned by 10.0.0.3.  The authority 192.0.2.1 has no
; range, it must not be queried.  The query to the owner carries the
; CLUSTER option, version 1, flags PEER and CACHE_ONLY (the step 1 probe), node id of 10.0.0.1@53.

STEP 1 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 2 CHECK_OUT_QUERY
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8			; option 65480, CLUSTER
		00 0a			; length 10
		01 03			; version 1, flags PEER and CACHE_ONLY (step 1)
		c1 68 3f 06 a9 43 ed 49	; node id
	HEX_EDNSDATA_END
ENTRY_END

; part of the deadline passes
STEP 3 TIME_PASSES ELAPSE 0.05

STEP 4 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
ENTRY_END

STEP 5 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
ENTRY_END

; the deadline would have passed now, nothing must happen
STEP 6 TIME_PASSES ELAPSE 0.2

; the answer is in the cache
STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 11 CHECK_ANSWER
ENTRY_BEGIN
MATCH all ttl
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
ENTRY_END

SCENARIO_END
