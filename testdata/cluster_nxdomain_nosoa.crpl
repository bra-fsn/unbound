		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 23 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
o.example.com. IN A
SECTION AUTHORITY
o.example.com. 5 IN SOA ns.other.example.net. h.example.net. 1 2 3 4 5
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 24 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
o.example.com. IN A
SECTION AUTHORITY
o.example.com. 5 IN SOA ns.other.example.net. h.example.net. 1 2 3 4 5
ENTRY_END

