; config options
server:
	access-control: 10.0.0.0/8 allow
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a query from a peer is resolved locally, and never forwarded.
; www.example.com is owned by 10.0.0.3, not by this node.  The peers have
; no ranges, forwarding the peer query would hang and fail the test.

RANGE_BEGIN 0 400
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
ENTRY_END
RANGE_END

; a query with the CLUSTER option of a peer node
STEP 1 QUERY ADDRESS 10.0.0.2
ENTRY_BEGIN
MATCH ednsdata
REPLY RD
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; Opcode 65480 CLUSTER
		00 0a           ; Length 10
		01 01           ; version 1, flags PEER
		00 00 00 00 00 00 00 02 ; node id of the sender
	HEX_EDNSDATA_END
ENTRY_END

; the answer has the CLUSTER option from the owner, not from cache
STEP 10 CHECK_ANSWER
ENTRY_BEGIN
MATCH all ednsdata
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; Opcode 65480 CLUSTER
		00 0a           ; Length 10
		01 01           ; version 1, flags PEER
		c1 68 3f 06 a9 43 ed 49 ; node id of this node
	HEX_EDNSDATA_END
ENTRY_END

; again, answered from the cache, with the cache hit flag
STEP 20 QUERY ADDRESS 10.0.0.2
ENTRY_BEGIN
MATCH ednsdata
REPLY RD
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; Opcode 65480 CLUSTER
		00 0a           ; Length 10
		01 01           ; version 1, flags PEER
		00 00 00 00 00 00 00 02 ; node id of the sender
	HEX_EDNSDATA_END
ENTRY_END

STEP 30 CHECK_ANSWER
ENTRY_BEGIN
MATCH all ednsdata
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; Opcode 65480 CLUSTER
		00 0a           ; Length 10
		01 05           ; version 1, flags PEER and OWNER_CACHE_HIT
		c1 68 3f 06 a9 43 ed 49 ; node id of this node
	HEX_EDNSDATA_END
ENTRY_END

SCENARIO_END
