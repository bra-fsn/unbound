; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a miss is routed to the owner, step 1 cache probe hit, and the answer is used.
; www.example.com is owned by 10.0.0.3 in the cluster 10.0.0.1-3.
; The authority 192.0.2.1 has no range, it must not be queried.

; the owner
RANGE_BEGIN 0 100
	ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. IN A 10.20.30.40
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; Opcode 65480 CLUSTER
		00 0a           ; Length 10
		01 05           ; version 1, flags PEER and OWNER_CACHE_HIT
		00 00 00 00 00 00 00 03 ; node id of the owner
	HEX_EDNSDATA_END
ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
www.example.com. IN A
ENTRY_END

; the query to the owner has the CLUSTER option, version 1, PEER and CACHE_ONLY flags,
; and the node id of this node 10.0.0.1@53.
STEP 2 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; Opcode 65480 CLUSTER
		00 0a           ; Length 10
		01 03           ; version 1, flags PEER and CACHE_ONLY (step 1)
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 10 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. IN A 10.20.30.40
ENTRY_END

; the answer is cached; the owner is not asked again.  The range of the
; owner has ended by now, so a new query to the owner would get no answer
; and the check would fail.
STEP 200 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 210 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. IN A 10.20.30.40
ENTRY_END

SCENARIO_END
