; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a CNAME answer of the owner to the resolve request (step 2), the chain is followed locally.
; h.example.com is owned by 10.0.0.3.  The probe misses, the owner is asked to
; resolve and answers with the CNAME and the target.  The chain is followed
; with the iterator, from the authority.  No fallback happens: the owner is
; not asked again and the answer is cached.
RANGE_BEGIN 0 4000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
t.example.com. IN A
SECTION ANSWER
t.example.com. 3600 IN A 10.9.9.5
ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
h.example.com. IN A
ENTRY_END

STEP 2 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
h.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 03
		c1 68 3f 06 a9 43 ed 49
	HEX_EDNSDATA_END
ENTRY_END

STEP 3 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA REFUSED
SECTION QUESTION
h.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 09
		00 00 00 00 00 00 00 03
	HEX_EDNSDATA_END
ENTRY_END

STEP 4 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
h.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 01
		c1 68 3f 06 a9 43 ed 49
	HEX_EDNSDATA_END
ENTRY_END

STEP 5 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN CNAME t.example.com.
t.example.com. 3600 IN A 10.7.7.7
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 01
		00 00 00 00 00 00 00 03
	HEX_EDNSDATA_END
ENTRY_END

STEP 6 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN CNAME t.example.com.
t.example.com. 3600 IN A 10.9.9.5
ENTRY_END

STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
h.example.com. IN A
ENTRY_END

STEP 11 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN CNAME t.example.com.
t.example.com. 3600 IN A 10.9.9.5
ENTRY_END

SCENARIO_END
