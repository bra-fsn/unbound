; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a CNAME answer of the owner, the chain is followed by local resolution.
; h.example.com is owned by 10.0.0.3.  It answers the cache probe with the
; CNAME and the remainder of the chain, the address of the target.  The
; scrubber of the iterator cuts the remainder off (harden-cname-follow), so
; that the iterator resolves it.  This node must not return the CNAME alone,
; it follows the chain with the iterator, from the authority.  The target
; is resolved locally, it is not sent to the owner of the target (there is
; no query to a peer in the steps), and the address that the authority gives
; is the one in the answer, and not the one that the owner sent along.
; The owner is not marked down, a second name is routed to it as before.
RANGE_BEGIN 0 4000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
t.example.com. IN A
SECTION ANSWER
t.example.com. 3600 IN A 10.9.9.5
ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
h.example.com. IN A
ENTRY_END

STEP 2 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
h.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 3 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN CNAME t.example.com.
t.example.com. 3600 IN A 10.7.7.7
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN CNAME t.example.com.
t.example.com. 3600 IN A 10.9.9.5
ENTRY_END

; the answer is in the cache, with the whole chain: no query is sent
STEP 5 TIME_PASSES ELAPSE 1.0

STEP 6 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
h.example.com. IN A
ENTRY_END

STEP 7 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN CNAME t.example.com.
t.example.com. 3600 IN A 10.9.9.5
ENTRY_END

; the owner is still up
STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
n.example.com. IN A
ENTRY_END

STEP 11 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
n.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 12 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
n.example.com. IN A
SECTION ANSWER
n.example.com. 3600 IN A 10.8.8.2
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 13 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
n.example.com. IN A
SECTION ANSWER
n.example.com. 3600 IN A 10.8.8.2
ENTRY_END

SCENARIO_END
