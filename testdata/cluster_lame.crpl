; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a referral or empty answer of the owner is rejected, the query is resolved locally, the owner is not marked down.
; h, n, o, x, t .example.com are owned by 10.0.0.3.  It answers h with a
; referral, n with an empty answer, o with a NODATA without SOA, and x with
; an NXDOMAIN without SOA.
; Four of those would mark the owner down if they were health failures.

RANGE_BEGIN 0 4000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN A 10.8.8.1
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
n.example.com. IN A
SECTION ANSWER
n.example.com. 3600 IN A 10.8.8.2
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
o.example.com. IN A
SECTION ANSWER
o.example.com. 3600 IN A 10.8.8.3
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
x.example.com. IN A
SECTION ANSWER
x.example.com. 3600 IN A 10.8.8.4
ENTRY_END
RANGE_END

STEP 1 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
h.example.com. IN A
ENTRY_END

STEP 2 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
h.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 3 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION AUTHORITY
example.com. 3600 IN NS ns.example.com.
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN A 10.8.8.1
ENTRY_END

STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
n.example.com. IN A
ENTRY_END

STEP 11 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
n.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 12 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
n.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 13 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
n.example.com. IN A
SECTION ANSWER
n.example.com. 3600 IN A 10.8.8.2
ENTRY_END

STEP 20 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
o.example.com. IN A
ENTRY_END

STEP 21 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
o.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 22 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
o.example.com. IN A
SECTION AUTHORITY
other.example.net. 3600 IN SOA ns.other.example.net. h.example.net. 1 2 3 4 5
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 23 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
o.example.com. IN A
SECTION ANSWER
o.example.com. 3600 IN A 10.8.8.3
ENTRY_END

STEP 24 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
x.example.com. IN A
ENTRY_END

STEP 25 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
x.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 26 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NXDOMAIN
SECTION QUESTION
x.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 27 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
x.example.com. IN A
SECTION ANSWER
x.example.com. 3600 IN A 10.8.8.4
ENTRY_END

; the owner is still up
STEP 30 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
t.example.com. IN A
ENTRY_END

STEP 31 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
t.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 32 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
t.example.com. IN A
SECTION ANSWER
t.example.com. 3600 IN A 10.9.9.5
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 01           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 33 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
t.example.com. IN A
SECTION ANSWER
t.example.com. 3600 IN A 10.9.9.5
ENTRY_END

SCENARIO_END
