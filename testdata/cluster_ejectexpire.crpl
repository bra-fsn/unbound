RANGE_END

; A=10.0.0.3 is ejected after three charged failures (the limit is one)
STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
x6.example.com. IN A
ENTRY_END

STEP 20 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
x6.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 03
		c1 68 3f 06 a9 43 ed 49
	HEX_EDNSDATA_END
ENTRY_END

STEP 30 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA REFUSED
SECTION QUESTION
x6.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 09
		00 00 00 00 00 00 00 03
	HEX_EDNSDATA_END
ENTRY_END

