; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	discard-timeout: 0
	module-config: "cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-peer: 10.0.0.4
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: the slot of a resolve-ejected peer is released when its ejection time is over.
; Four peers, so at most one is resolve-ejected.  The owners 10.0.0.3 (A) and
; 10.0.0.4 (B) fail resolve requests with SERVFAIL, that a fast local
; fallback resolves (charged failures).  When the ejection of A is over its slot
; is free at once, before its trial request, so B can be ejected; a failed
; trial takes a slot again if there is one.
RANGE_BEGIN 0 1000000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
x6.example.com. IN A
SECTION ANSWER
x6.example.com. 3600 IN A 10.8.8.1
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
x7.example.com. IN A
SECTION ANSWER
