; config options
server:
	access-control: 10.0.0.0/8 allow
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "dns64 validator cluster iterator"
	dns64-prefix: 64:ff9b::/96

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a cache only probe for AAAA with dns64 is not resolved, also not the A subquery of dns64 for the synthesis, it is answered REFUSED with MISS.
; This node is the owner.  No range answers: any query to the authority is
; a failure of the test.
STEP 1 QUERY ADDRESS 10.0.0.2
ENTRY_BEGIN
MATCH ednsdata
REPLY RD
SECTION QUESTION
www.example.com. IN AAAA
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags PEER|CACHE_ONLY
		00 00 00 00 00 00 00 02 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 2 CHECK_ANSWER
ENTRY_BEGIN
MATCH all ednsdata
REPLY QR RD RA REFUSED
SECTION QUESTION
www.example.com. IN AAAA
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 09           ; version 1, flags PEER|MISS
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

SCENARIO_END
