MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA SERVFAIL
SECTION QUESTION
p21.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 01
		00 00 00 00 00 00 00 04
	HEX_EDNSDATA_END
ENTRY_END

STEP 590 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
p21.example.com. IN A
SECTION ANSWER
p21.example.com. 3600 IN A 10.8.8.17
ENTRY_END

STEP 600 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
p27.example.com. IN A
ENTRY_END

STEP 610 CHECK_OUT_QUERY ADDRESS 10.0.0.4
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
p27.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 03
		c1 68 3f 06 a9 43 ed 49
	HEX_EDNSDATA_END
ENTRY_END

STEP 620 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA REFUSED
SECTION QUESTION
p27.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 09
		00 00 00 00 00 00 00 04
	HEX_EDNSDATA_END
ENTRY_END

STEP 630 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
p27.example.com. IN A
SECTION ANSWER
p27.example.com. 3600 IN A 10.8.8.18
ENTRY_END

SCENARIO_END
