; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-peer: 10.0.0.4
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: at most floor(30% of the peers) are resolve-ejected at once (4 peers: one).
; Two owners, 10.0.0.3 and 10.0.0.4, both fail resolve requests with SERVFAIL
; that a fast local fallback resolves.  The first is ejected after three
; charged failures, the second is not (the limit is one): it is still asked to
; resolve.  When the first recovers (a successful trial), the second can be
; ejected.
RANGE_BEGIN 0 100000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
q1.example.com. IN A
SECTION ANSWER
q1.example.com. 3600 IN A 10.8.8.1
ENTRY_END
