; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	; no client budget: the step 2 deadline is the cap, CLUSTER_RESOLVE_MAX (3 s)
	discard-timeout: 0
	module-config: "cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: the resolve step is a UDP query, governed by the module deadline, it is never sent again.
; UDP_TIMEOUTS: the pending UDP queries time out by themselves, with the
; timeout of the infra cache (376 msec unless raised), as the outside network
; does.  This is what the RTO floor of the resolve step is for.
UDP_TIMEOUTS
; h, n, o, r, t, u, w are owned by 10.0.0.3.  The owner misses the cache
; probe, then recurses for the resolve request (step 2), a UDP query too.  A
; slow answer, at 1.5 s and at 2.9 s, is used with no fallback and with no
; second query: the outgoing UDP timeout is raised to the module deadline
; (3 s), so it neither times out nor sends the query again before that.  A
; timeout or an error of the outgoing query is a failure of step 2: the query
; is resolved locally at once, the resolve request is not sent again (a
; second query would be left pending, which testbound reports), and the
; owner is not marked down (it is probed for the next names).  The deadline
; passing is the same.  Answers of the owner have addresses 10.9.9.x, of the
; authority 10.8.8.x.
RANGE_BEGIN 0 1000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
h.example.com. IN A
SECTION ANSWER
h.example.com. 3600 IN A 10.8.8.1
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
n.example.com. IN A
SECTION ANSWER
n.example.com. 3600 IN A 10.8.8.2
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
o.example.com. IN A
SECTION ANSWER
o.example.com. 3600 IN A 10.8.8.3
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
r.example.com. IN A
SECTION ANSWER
r.example.com. 3600 IN A 10.8.8.4
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
t.example.com. IN A
SECTION ANSWER
t.example.com. 3600 IN A 10.8.8.5
ENTRY_END
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
