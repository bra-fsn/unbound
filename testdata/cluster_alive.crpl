; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a lossy owner that keeps answering stays up, a silent owner is marked down.
; The down rule: three consecutive failed probes AND no valid reply from the
; peer for one second.  The names are owned by 10.0.0.3.
RANGE_BEGIN 0 1000
	ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
q1.example.com. IN A
SECTION ANSWER
q1.example.com. 3600 IN A 10.8.8.1
ENTRY_END
ENTRY_BEGIN
