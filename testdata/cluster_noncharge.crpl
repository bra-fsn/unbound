; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"
	discard-timeout: 0
cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-peer: 10.0.0.4
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: failures of the owner resolve request are not charged when the local fallback is slow or fails, the owner is never resolve-ejected.
; 4 peers, the names are owned by 10.0.0.3, that answers the cache probes
; (MISS) and fails the resolve request: SERVFAIL, or no reply at all (the
; deadline, 3 seconds here with discard-timeout 0).  The authority, the only
; upstream, is slow (600 msec) or fails as well: the failure is not charged
; to the owner.  Six such failures (more than the three that eject a charged
; owner), and the owner is still asked to resolve.

; SERVFAIL of the owner, the local fallback answers after 600 msec: no charge

STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
q1.example.com. IN A
ENTRY_END

STEP 20 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
q1.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 03
		c1 68 3f 06 a9 43 ed 49
	HEX_EDNSDATA_END
ENTRY_END

STEP 30 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA REFUSED
SECTION QUESTION
q1.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8
		00 0a
		01 09
		00 00 00 00 00 00 00 03
	HEX_EDNSDATA_END
ENTRY_END

STEP 40 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
