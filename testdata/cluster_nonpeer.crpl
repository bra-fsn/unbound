; config options
server:
	access-control: 10.0.0.0/8 allow
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100
	# resolved here, like on the owner
	cluster-exclude: example.com

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: the CLUSTER option from an address that is not a cluster peer is ignored, a cache only probe from a client is resolved like a normal query and gets no echo.
; This node is the owner of www.example.com.

; a cache only probe from a client that is not a peer
STEP 1 QUERY ADDRESS 10.9.9.9
ENTRY_BEGIN
MATCH ednsdata
REPLY RD
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags PEER|CACHE_ONLY
		00 00 00 00 00 00 00 02 ; node id
	HEX_EDNSDATA_END
ENTRY_END

; it is resolved, not answered with a miss
STEP 2 CHECK_OUT_QUERY ADDRESS 192.0.2.1
ENTRY_BEGIN
MATCH qname qtype
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 3 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR AA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
ENTRY_END

; the answer has no CLUSTER option
STEP 4 CHECK_ANSWER
ENTRY_BEGIN
MATCH all ednsdata
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
	HEX_EDNSDATA_END
ENTRY_END

; a cache hit for a cache only probe of a client: no echo, no cache hit flag
STEP 10 QUERY ADDRESS 10.9.9.9
ENTRY_BEGIN
MATCH ednsdata
REPLY RD
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags PEER|CACHE_ONLY
		00 00 00 00 00 00 00 02 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 11 CHECK_ANSWER
ENTRY_BEGIN
MATCH all ednsdata
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
	HEX_EDNSDATA_END
ENTRY_END

; the same probe from a peer gets the cache hit flag
STEP 20 QUERY ADDRESS 10.0.0.2
ENTRY_BEGIN
MATCH ednsdata
REPLY RD
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags PEER|CACHE_ONLY
		00 00 00 00 00 00 00 02 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 21 CHECK_ANSWER
ENTRY_BEGIN
MATCH all ednsdata
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.40
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 05           ; version 1, flags PEER|OWNER_CACHE_HIT
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

SCENARIO_END
