; config options
server:
	target-fetch-policy: "0 0 0 0 0"
	qname-minimisation: no
	module-config: "validator cluster iterator"

cluster:
	cluster-peer: 10.0.0.1
	cluster-peer: 10.0.0.2
	cluster-peer: 10.0.0.3
	cluster-self: 10.0.0.1
	cluster-timeout: 100

stub-zone:
	name: "example.com"
	stub-addr: 192.0.2.1
CONFIG_END

SCENARIO_BEGIN Cluster: a stale answer of the owner is used for the client but not stored.
; The owner answers with the STALE flag.  The query is sent to the owner
; again, the answer was not stored in the cache, not by this module and not
; by the validator.  The next answer without the flag is stored.

STEP 1 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 2 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 3 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 30 IN A 10.20.30.40
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 15           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 4 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 30 IN A 10.20.30.40
ENTRY_END

; not in the cache, the owner is asked again
STEP 10 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 11 CHECK_OUT_QUERY ADDRESS 10.0.0.3
ENTRY_BEGIN
MATCH qname qtype opcode ednsdata
SECTION QUESTION
www.example.com. IN A
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 03           ; version 1, flags
		c1 68 3f 06 a9 43 ed 49 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 12 REPLY
ENTRY_BEGIN
MATCH opcode qtype qname
ADJUST copy_id
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.41
SECTION ADDITIONAL
	HEX_EDNSDATA_BEGIN
		ff c8           ; CLUSTER option
		00 0a           ; length 10
		01 05           ; version 1, flags
		00 00 00 00 00 00 00 03 ; node id
	HEX_EDNSDATA_END
ENTRY_END

STEP 13 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.41
ENTRY_END

; now it is in the cache, no query is sent
STEP 20 QUERY
ENTRY_BEGIN
REPLY RD
SECTION QUESTION
www.example.com. IN A
ENTRY_END

STEP 21 CHECK_ANSWER
ENTRY_BEGIN
MATCH all
REPLY QR RD RA NOERROR
SECTION QUESTION
www.example.com. IN A
SECTION ANSWER
www.example.com. 3600 IN A 10.20.30.41
ENTRY_END

SCENARIO_END
